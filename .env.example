# AWS credentials - leave blank until real creds are supplied. Absence of creds
# (rather than a mock/live flag) is what config/settings.py auto-detects to
# fall back to mock mode - see BEDROCK_MOCK_MODE below.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# blank = auto-detect (mock if no AWS creds resolve via boto3.Session().get_credentials()).
# Set explicitly to 'true' or 'false' to override auto-detection.
BEDROCK_MOCK_MODE=

# Bedrock model IDs. Defaults are current, non-retired model IDs as of Aug 2026 -
# anthropic.claude-3-5-sonnet-* was retired from Bedrock in Oct 2025; do not
# revert to a dated snapshot ID without checking it is still served.
BEDROCK_CHAT_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0

# azure | bedrock - which provider rag/llm/factory.py and
# rag/embeddings/factory.py dispatch to. The Bedrock provider above is kept
# fully working and selectable again by flipping this back.
LLM_PROVIDER=azure

# Azure AD service principal - not yet consumed by any provider (the chat/
# embeddings clients below use key auth), reserved for a future AD-token
# auth path if one is needed.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure AI Inference (Azure AI Foundry / Cognitive Services) - same
# ChatCompletionsClient shape as CloudOps-AWS's backend-agent/utils/model_client.py.
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
# Chat deployment name. AZURE_AI_CHAT_MODEL wins if set; otherwise falls back
# to OPENAI_MODEL, then to "gpt-4o-mini".
AZURE_AI_CHAT_MODEL=
OPENAI_MODEL=
# Embedding deployment name - leave blank to keep embeddings on the mock
# implementation even when the chat model is live (no embedding deployment
# has been provisioned yet).
AZURE_AI_EMBED_MODEL=
# blank = auto-detect (mock if AZURE_AI_ENDPOINT/AZURE_AI_KEY aren't both set).
AZURE_MOCK_MODE=

# none | bedrock_cohere | llm
RERANK_PROVIDER=none

CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rca_docs

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# heuristic | llm
EVAL_JUDGE_PROVIDER=heuristic
